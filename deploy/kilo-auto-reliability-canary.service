[Unit]
Description=Kilo Auto reliability isolated Canary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=ADDR=172.17.0.1:18351
Environment=KILO_AUTO_RELIABILITY_ENABLED=true
Environment=TRUSTED_NEWAPI_ERROR_DIAGNOSTICS=true
Environment=REQUEST_LOG_ENABLED=true
Environment=REQUEST_LOG_DIR=/var/log/kilo-auto-reliability-canary
Environment=REQUEST_LOG_RETENTION=24h
Environment=REQUEST_LOG_BODY_LIMIT=1
Environment=UPSTREAM_TIMEOUT=180s
ExecStart=/opt/kilo-newapi-canary/kilo-auto-reliability/kilo-newapi-adapter
Restart=always
RestartSec=3
User=root
WorkingDirectory=/opt/kilo-newapi-adapter

NoNewPrivileges=true
PrivateTmp=true
LogsDirectory=kilo-auto-reliability-canary
LogsDirectoryMode=0700

[Install]
WantedBy=multi-user.target
