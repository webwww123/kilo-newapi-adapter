[Unit]
Description=Retain inactive Kilo daily request logs for 48 hours
ConditionPathIsDirectory=/var/log/kilo-newapi-adapter

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/lib/kilo-request-log-retention/retention.py --apply
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/kilo-newapi-adapter /run/lock
RestrictAddressFamilies=AF_UNIX
