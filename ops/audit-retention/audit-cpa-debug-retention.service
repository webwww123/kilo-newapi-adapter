[Unit]
Description=Bound CPA migration debug logs and keep three recent tail archives
ConditionPathIsDirectory=/var/log/private

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/lib/audit-log-retention/retention.py --kind debug --apply
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/private /run/lock
RestrictAddressFamilies=AF_UNIX
