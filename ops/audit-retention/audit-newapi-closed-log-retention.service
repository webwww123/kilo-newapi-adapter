[Unit]
Description=Retain closed legacy NewAPI diagnostic logs for 48 hours
ConditionPathIsDirectory=/root/new-api-official-latest/logs

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/lib/audit-log-retention/retention.py --kind newapi --apply
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/new-api-official-latest/logs /run/lock
RestrictAddressFamilies=AF_UNIX
