[Unit]
Description=Retain closed Inkling daily request logs for 48 hours
ConditionPathIsDirectory=/var/log/kilo-newapi-adapter-inkling-migration

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/lib/audit-log-retention/retention.py --kind inkling --apply
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/kilo-newapi-adapter-inkling-migration /run/lock
RestrictAddressFamilies=AF_UNIX
